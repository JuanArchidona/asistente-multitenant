# Copia este archivo a .env y rellena las claves.

# --- Sistema bajo prueba (el MVP de la 3.1) ---
LLM_PROVIDER=anthropic          # anthropic | gemini
ANTHROPIC_API_KEY=
# Clave DISTINTA para el juez del banco de evaluacion. No es opcional cuando se
# ejecuta con juez: tenerla aparte es lo que permite que la factura del proveedor
# responda por separado cuanto cuesta funcionar y cuanto cuesta evaluar.
ANTHROPIC_API_KEY_JUEZ=
ANTHROPIC_MODEL_ROUTER=claude-haiku-4-5
ANTHROPIC_MODEL_GENERATOR=claude-haiku-4-5
GEMINI_API_KEY=                 # imprescindible: los embeddings siempre son Gemini
# Modelo de chat de Gemini, usado cuando LLM_PROVIDER=gemini y como juez cuando
# JUDGE_PROVIDER=gemini. Era gemini-2.5-flash y se cambio el 22-09-2026: ese
# modelo devuelve 404 'no longer available to new users' en cualquier proyecto
# de Google creado despues de su retirada, asi que nadie que clonase el repo
# podria reproducir la conmutacion de proveedor. Ver docs/HALLAZGOS.md 29.
GEMINI_MODEL=gemini-3.6-flash

# --- Embeddings e índice ---
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768                  # 768 | 1536 | 3072 (Matryoshka)
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=corpus_empresa
CORPUS_PATH=corpus

# --- Parámetros de calidad (los ejes del barrido de evals/sweep.py) ---
CHUNK_STRATEGY=chars            # chars | headings
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
DISTANCE_THRESHOLD=             # vacío = desactivado (comportamiento de la 3.1)
# Temperatura del enrutador. Vacio = 0.0, que es el valor por defecto desde el
# 22-09-2026: a 0 la varianza del enrutado desaparece y el acierto sube en los
# dos inquilinos (docs/HALLAZGOS.md 27). Pon 'defecto' para volver a no enviar
# el parametro, que es como corrieron las 15 ejecuciones anteriores; es la unica
# forma de reproducir una cifra historica.
ROUTER_TEMPERATURE=
GEN_POLICY=base                 # base | hardened (prompt con reglas de confidencialidad)

# --- Evaluación ---
# El juez nunca puede ser el mismo modelo que el generador evaluado.
JUDGE_PROVIDER=anthropic        # anthropic | gemini
# Clave propia del juez cuando JUDGE_PROVIDER=gemini. Obligatoria y distinta
# de GEMINI_API_KEY: esa es la de los embeddings, que son parte del sistema,
# y compartirla sumaria el gasto del juez al del sistema en la misma linea de
# factura.
#
# Tiene que salir de un PROYECTO DISTINTO de Google, no solo ser otra clave: la
# documentacion de Gemini dice que los limites y la facturacion se aplican por
# proyecto y no por clave, asi que dos claves del mismo proyecto comparten cuota
# y linea de factura. Es distinto de Anthropic, donde la consola desglosa por
# clave. Ver docs/HALLAZGOS.md 18 y 24.
GEMINI_API_KEY_JUEZ=
JUDGE_MODEL=claude-sonnet-5
# Modelo que construye y critica el banco sintético (tampoco puede ser el evaluado).
BUILDER_MODEL=claude-sonnet-5
